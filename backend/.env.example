# --- Keyless mode: runs today, no accounts, no credentials -------------
# Synthetic catalogue in data/mock/ + lexical embeddings + rule-based
# generation. Proves the machinery, not recommendation quality.
# Build the catalogue first: python scripts/build_mock_catalogue.py
#
# DATA_DIR=data/mock
# EMBEDDING_MODEL=hashing-bow-v1
# EMBEDDING_DIMS=256
# GENERATION_PRIMARY=mock

# --- Real mode: keys + a built catalogue -------------------------------
# EMBEDDING_MODEL and EMBEDDING_DIMS must match data/embeddings.manifest.json
# or startup fails with ManifestMismatch. That check is deliberate: query
# vectors and catalogue vectors must come from the same model.
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMS=768

# Jina AI: an alternative embedding provider (scripts/ingest_enriched.py
# --embedder jina, or EMBEDDING_MODEL=jina-embeddings-v3 / EMBEDDING_DIMS=768
# at runtime). Free tier is 100 RPM / 100K TPM, far roomier than Gemini's
# embedding quota for a one-off catalogue build.
JINA_API_KEY=

# GitHub Models: a GitHub personal access token with the models:read scope,
# not an API key. Free, with a low daily ceiling — good as an overflow
# provider late in the chain, poor as a primary.
GITHUB_TOKEN=

# Ordered generation chain. Each provider is tried in turn; one with no
# credential is skipped, not fatal. Falls back to
# GENERATION_PRIMARY/GENERATION_FALLBACK below when unset.
GENERATION_CHAIN=gemini,cerebras,groq,github
GENERATION_PRIMARY=gemini
GENERATION_FALLBACK=groq

CEREBRAS_MODEL=llama-3.3-70b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
GITHUB_MODEL=openai/gpt-4o-mini
GITHUB_BASE_URL=https://models.github.ai/inference

# --- Key rotation ------------------------------------------------------
# Several keys per provider, comma-separated. A rate limit rotates to the next
# key and retries; anything else fails immediately (rotating on a bad prompt
# would burn every key discovering the same error).
#
# Rotation is NOT fallback. A second key is the same model in the same vector
# space, which is why embeddings may rotate keys but must never change
# provider. Merged with the singular form above, so either spelling works.
#
# GEMINI_API_KEYS=key1,key2,key3
# GROQ_API_KEYS=key1,key2
# CEREBRAS_API_KEYS=key1,key2
# GITHUB_TOKENS=ghp_one,ghp_two

CORS_ORIGINS=http://localhost:5173

# --- Database ----------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/catalogue
